{
  "name": "simple-wms-telegram",
  "version": "0.1.0",
  "description": "Simple WMS + Telegram - advanced warehouse management (Cloudflare Workers + D1)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/salin-worker-pdf.mjs",
    "prebuild": "node scripts/salin-worker-pdf.mjs",
    "predev": "node scripts/salin-worker-pdf.mjs",
    "test": "node --test \"test/**/*.test.js\" && npx esbuild worker/auth.test.ts --bundle --platform=node --format=esm --outfile=.tmp-auth-npm.test.mjs --log-level=error && node --test .tmp-auth-npm.test.mjs && rm -f .tmp-auth-npm.test.mjs",
    "test:worker": "node scripts/jalankan-tes-worker.mjs",
    "peta:indeks": "node scripts/peta-indeks.mjs",
    "peta:verifikasi": "node scripts/peta-verifikasi.mjs",
    "dev:vercel": "vercel dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-build.mjs && playwright test",
    "e2e:fast": "playwright test --project=desktop --project=desktop-viewport",
    "e2e:full": "node scripts/e2e-build.mjs && playwright test",
    "e2e:dev": "playwright test",
    "e2e:build": "node scripts/e2e-build.mjs",
    "preview": "node scripts/bangun-opennext.mjs && opennextjs-cloudflare preview",
    "deploy": "node scripts/bangun-opennext.mjs && opennextjs-cloudflare deploy",
    "upload": "node scripts/bangun-opennext.mjs && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/generative-ai": "^0.21.0",
    "@opennextjs/cloudflare": "^1.20.9",
    "@vercel/functions": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fabric": "^7.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.7.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.46.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
