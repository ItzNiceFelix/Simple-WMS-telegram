# ============================================
# TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# ============================================
# FIREBASE (Firestore - Spark/free plan)
# Ambil dari Firebase Console > Project Settings > Service Accounts > Generate new private key
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PENTING: private key punya newline (\n) di dalamnya.
# Saat isi di Vercel env var, paste apa adanya (Vercel handle newline).
# Kalau simpan di .env lokal, bungkus dengan tanda kutip dan biarkan \n sebagai teks literal.
FIREBASE_PRIVATE_KEY=
# Alternatif: kalau ketiga var di atas dikosongkan, lib/firebase.js fallback ke Application
# Default Credentials. Jalankan gcloud auth application-default login (atau set
# GOOGLE_APPLICATION_CREDENTIALS ke path JSON service account). Berguna utk script lokal.

# ============================================
# GEMINI API (free tier)
# ============================================
GEMINI_API_KEY=

# ============================================
# GOOGLE SHEETS API (dipakai mulai Batch 6)
# Bisa pakai service account yang sama dengan Firebase, atau terpisah
# ============================================
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# ============================================
# AI / PROVIDER
# ============================================
# Provider teks default. Terima salah satu: gemini | groq | kenari | openai | openrouter
# (default "groq" bila kosong). Bisa diubah runtime lewat dashboard. Lihat lib/ai/registry.js.
AI_PROVIDER_TEXT=
# Groq (OpenAI-compatible) — key WAJIB kalau provider groq dipakai (soft-warn saja).
GROQ_API_KEY=
# Opsional: override base URL / model Groq.
GROQ_BASE_URL=
GROQ_MODEL_TEXT=
# Kenari (OpenAI-compatible) — key WAJIB kalau provider kenari dipakai (soft-warn saja).
KENARI_API_KEY=
# Opsional: override base URL / model Kenari.
KENARI_BASE_URL=
KENARI_MODEL_TEXT=
# OpenAI — key WAJIB kalau provider openai dipakai (soft-warn saja).
OPENAI_API_KEY=
# Opsional: override base URL / model OpenAI.
OPENAI_BASE_URL=
OPENAI_MODEL_TEXT=
# OpenRouter (OpenAI-compatible) — key WAJIB kalau provider openrouter dipakai (soft-warn saja).
OPENROUTER_API_KEY=
# Opsional: override base URL / model OpenRouter.
OPENROUTER_BASE_URL=
OPENROUTER_MODEL_TEXT=
# Batas waktu Gemini (ms) dan batas total semua percobaan provider (ms).
GEMINI_TIMEOUT_MS=
GEMINI_TOTAL_TIMEOUT_MS=
AI_RATE_LIMIT_PER_MINUTE=

# ============================================
# GOOGLE SHEETS (lanjutan)
# ============================================
# Batas waktu operasi Sheets, dibaca lib/sheets/client.js
SHEETS_TIMEOUT_MS=

# ============================================
# AKSES / ADMIN
# ============================================
# Telegram user_id dari Super Admin (source of truth cadangan, lihat bagian 4H dokumen skema)
SUPER_ADMIN_ID=

# ============================================
# DASHBOARD (Next.js Mini App)
# ============================================
# Arahan rinci: docs/dashboard-deploy.md

# --- Sumber data ---
# mock = data lokal deterministik (dev + uji Playwright, TIDAK menyentuh jaringan).
# real = baca Firestore via client SDK + tulis stok via route server.
# WAJIB "real" di produksi. Nilai ini di-inline saat build, jadi ubah lalu redeploy.
# Cara dapat: tidak perlu kredensial; cukup pilih mode.
NEXT_PUBLIC_DASHBOARD_DATA=mock

# --- Origin allowlist (proteksi CSRF, PRD 11.10) ---
# Fungsi: daftar origin yang boleh POST ke route dashboard. Request dengan header Origin
# di luar daftar ditolak 403. Mencegah situs lain memanggil route tulis.
# PENTING: TANPA trailing slash. Header Origin browser tidak pernah berisi "/",
# jadi "https://x.vercel.app/" TIDAK akan cocok dan request ditolak 403.
# Cara dapat: URL dashboard di Vercel. Untuk produksi biasanya
#   https://<nama-project>.vercel.app
# Untuk preview deployment, tambahkan juga domain preview (dipisah koma), mis.
#   https://<project>.vercel.app,https://<project>-git-main-<akun>.vercel.app
# Bila dibiarkan kosong: hanya diizinkan di lingkungan non-produksi.
DASHBOARD_ALLOWED_ORIGINS=

# --- Secret cookie sesi ---
# Fungsi: kunci HMAC untuk menandatangani cookie sesi (dat_sesi). Tanpa ini cookie mudah dipalsukan.
# Cara dapat: buat string acak panjang (min. 32 karakter). Salah satu cara:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bila dikosongkan: jatuh ke TELEGRAM_BOT_TOKEN (kurang ideal, sebaiknya diisi eksplisit).
DASHBOARD_SESSION_SECRET=

# --- Firebase client config (PUBLIK, aman di-expose) ---
# Fungsi: dipakai SDK Firebase di browser untuk baca Firestore (stock, products,
# stock_movements, dst) sebagai user berklaim role. Keamanan dijaga Firestore Security Rules,
# BUKAN oleh kerahasiaan nilai ini.
# Cara dapat: Firebase Console -> Project settings (ikon gerigi) -> General ->
# "Your apps" -> pilih Web App (</>). Bila belum ada, klik "Add app" -> Web.
# Salin nilai dari objek firebaseConfig yang ditampilkan.
#   firebaseConfig.apiKey            -> NEXT_PUBLIC_FIREBASE_API_KEY
#   firebaseConfig.authDomain        -> NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   firebaseConfig.projectId         -> NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   firebaseConfig.appId             -> NEXT_PUBLIC_FIREBASE_APP_ID
# PENTING: yang di-paste HANYA blok firebaseConfig (kunci publik).
# Service account key (FIREBASE_PRIVATE_KEY) TIDAK PERNAH masuk ke NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Khusus pengujian lokal (JANGAN diset di produksi) ---
# Fungsi: mengizinkan mode mock jalan di build produksi, hanya untuk Playwright/e2e lokal
# (skrip scripts/e2e-build.mjs menyetelnya otomatis). Bila diset di produksi, siapa pun
# bisa memakai dashboard seolah owner (risiko R11).
# Gunakan juga saat mencoba build produksi lokal agar halaman dapat dibuka tanpa Firestore.
# JANGAN pernah diisi di Vercel.
# NEXT_PUBLIC_ALLOW_MOCK=true
